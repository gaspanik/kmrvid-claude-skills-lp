---
import { ArrowLeft, ArrowRight, Tag } from "@lucide/astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Callout from "@/components/Callout.astro";
import ImageLightbox from "@/components/ImageLightbox.astro";
import SkillCard from "@/components/SkillCard.astro";
import Layout from "@/layouts/Layout.astro";
import skillsDiagram from "@/assets/images/KMRVID_Skill_Map.webp";
import { categories, totalSkills } from "@/data/skills";

const PURCHASE_URL = "https://kmrvid.com/products/kmrvid-claude-skills";
---

<Layout title="収録スキル一覧 — KMRVID Claude Skills">
  <Header />

  <main>
    <section class="mx-auto px-6 pt-14 md:pt-20 max-w-5xl">
      <a
        href="/#skills"
        class="inline-flex items-center gap-1.5 min-h-11 text-ink-soft hover:text-accent text-sm transition"
      >
        <ArrowLeft size={16} stroke-width={2} />
        トップページに戻る
      </a>

      <p class="mt-8 text-ink-soft text-sm uppercase tracking-widest">
        収録スキル一覧
      </p>
      <h1 class="max-w-2xl text-ink max-sm:text-3xl text-left">
        全{totalSkills}スキル。<br
          class="sm:hidden"
        />実務のワークフローをまるごと自動化する
      </h1>
      <p
        class="mt-4 max-w-2xl text-ink-soft text-base text-justify leading-relaxed"
      >
        セットアップからモックアップ作成、Figma連携、Tailwindの整理、仕上げの品質チェックまで、Web制作の一連の工程をカテゴリごとに整理しました。使い方だけでなく作り方の解説も付いているため、自分の業務に合わせたカスタマイズや新規スキル開発の参考にもなります。
      </p>
      <p
        class="mt-4 max-w-2xl text-ink-soft text-base text-justify leading-relaxed"
      >
        2026年7月31日、公開中の Claude Code 用スキルの中から Figma Design Agent
        でも動作するスキルを移植。Figma
        に最適化された専用スキルを追加（15スキル／2026年8月6日現在）。Figma内での作業効率を大幅に向上させるカスタムスキルです。詳しくは
        <a href="/figma" class="text-accent underline underline-offset-4">
          KMRVID Figma Skills
        </a>
        のページをご覧ください。
      </p>

      <ImageLightbox
        image={skillsDiagram}
        thumbAlt="収録スキル同士の関係性を示した全体相関図"
        expandedAlt="収録スキル同士の関係性を示した全体相関図（拡大）"
        caption="スキル同士の組み合わせ・依存関係を俯瞰した全体相関図。クリックで拡大表示。"
      />
    </section>

    {
      categories.map((category) => (
        <section class="mx-auto px-6 py-14 md:py-20 max-w-5xl">
          <div class="flex items-center gap-3">
            <category.icon size={22} stroke-width={1.75} class="text-accent" />
            <h2 class="text-ink text-left">{category.name}</h2>
          </div>
          <p class="mt-2 text-ink-soft text-base text-justify leading-snug">
            {category.tagline}
          </p>

          {category.note && (
            <div class="mt-6">
              <Callout>{category.note}</Callout>
            </div>
          )}

          {category.ctaHref && (
            <a
              href={category.ctaHref}
              class="inline-flex items-center gap-1 mt-3 min-h-11 text-ink-soft hover:text-accent text-sm underline underline-offset-4 transition"
            >
              {category.ctaLabel}
              <ArrowRight size={14} stroke-width={2} />
            </a>
          )}

          <div class="*:flex *:flex-col gap-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 *:bg-canvas mt-8 *:p-6 *:border *:border-border *:rounded-2xl">
            {category.skills.map((skill) => (
              <SkillCard
                name={skill.name}
                desc={skill.desc}
                liteUrl={skill.liteUrl}
                liteLabel={skill.liteLabel}
              />
            ))}
          </div>
        </section>
      ))
    }

    <!-- ============ TRIAL NOTE ============ -->
    <section class="flex flex-col gap-4 mx-auto px-6 pb-14 md:pb-20 max-w-5xl">
      <Callout>
        購入前に動作を試したい方向けに、軽量版スキル「create-mockup-lite」を
        <a
          href="https://github.com/gaspanik/create-mockup-lite-skill"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4"
        >
          GitHub
        </a>
        にて無料公開しています。
      </Callout>
      <Callout>
        「create-mockup-lite」「click-to-fix」の紹介と作業環境についてこちらの
        <a
          href="https://youtu.be/TySJxHhMKNQ"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4"
        >
          YouTube
        </a>
        で動画を用意しています。
      </Callout>
    </section>

    <!-- ============ CTA ============ -->
    <section class="bg-ink py-20 md:py-28 text-canvas">
      <div
        class="flex flex-col items-center gap-6 mx-auto px-6 max-w-2xl text-center"
      >
        <Tag size={28} stroke-width={1.75} class="text-accent" />
        <h2 class="text-canvas">
          全{totalSkills}スキルを、<br class="sm:hidden" />27,500円で
        </h2>
        <p
          class="max-w-md text-white/70 text-base sm:text-center text-justify leading-relaxed"
        >
          27,500円（税込）の買い切りでお申し込みいただけます。
        </p>
        <a
          href={PURCHASE_URL}
          class="inline-flex items-center gap-2 bg-accent shadow-xs hover:brightness-110 px-8 py-4 rounded-full font-medium text-white transition"
        >
          27,500円で申し込む
          <ArrowRight size={18} stroke-width={2} />
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
