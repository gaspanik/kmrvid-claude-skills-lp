---
import {
  ArrowRight,
  ArrowUpRight,
  BadgePercent,
  CircleCheck,
  Combine,
  ExternalLink,
  FileText,
  Languages,
  ListChecks,
  Menu,
  MousePointerClick,
  SquareTerminal,
  Workflow,
  X,
} from "@lucide/astro";
import figmaWireframe from "@/assets/images/figma-wireframe.jpg";
import codeScreen from "@/assets/images/code-screen.jpg";
import Callout from "@/components/Callout.astro";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";

const PURCHASE_URL = "https://kmrvid.com/products/kmrvid-figma-skills";

const navLinks = [
  { href: "#diff", label: "通常版との違い" },
  { href: "#skills", label: "収録スキル" },
  { href: "/", label: "Claude版" },
  { href: "#how-to", label: "使い方" },
  { href: "#combos", label: "組み合わせ例" },
  { href: "#pricing", label: "料金" },
];

const differences = [
  {
    icon: MousePointerClick,
    title: "キャンバス上で選択したノードが対象",
    description:
      "Figma URL の貼り付けは不要。フレームやセクションを選択してチャットで呼び出すだけで動きます。",
  },
  {
    icon: SquareTerminal,
    title: "Plugin API 直接実行で完結",
    description:
      "Figma 側のスクリプト実行ツールだけで完結し、外部のMCPツールを参照しません。",
  },
  {
    icon: FileText,
    title: "カスタムスキル登録は1ファイルで完結",
    description:
      "SKILL.md 単体を登録すれば動作します。Figma のカスタムスキル登録機能にそのまま貼り付け可能。",
  },
  {
    icon: Languages,
    title: "質問も出力もすべて日本語",
    description:
      "スキルの指示本文は英語ですが、確認テーブル・質問・レポートはすべて日本語で表示されます。",
  },
];

const skills = [
  {
    name: "figma-layer-rename",
    desc: "自動生成レイヤー名を検出し、確認のうえセマンティックな名前にリネーム。レイヤーの兄弟間で重複している名前も、オプションで差別化リネームの対象に",
  },
  {
    name: "figma-audit",
    desc: "選択フレームのAI実装精度を4観点で採点し、コンパクトなレポートを出力（詳細は追加要求で表示）",
  },
  {
    name: "figma-component-audit",
    desc: "選択したコンポーネント/コンポーネントセット単体を、バリアント定義・コンポーネントプロパティ・レイヤー命名・Auto-layout・カラー/タイポグラフィトークンの5観点で採点",
  },
  {
    name: "brief-me",
    desc: "デザイン着手前のビジネス要件ヒアリング。create-multi-pattern の実行前の詳細な要件定義に。結果の BRIEF はチャットに出力",
  },
  {
    name: "design-brief-me",
    desc: "デザイン着手前の設定ヒアリング。結果のDESIGN_BRIEFを`brief-me`のBRIEFと一緒に貼り付けると、後続スキルの質問がすべて省略され完全無人実行が可能に",
  },
  {
    name: "rewrite-me",
    desc: "選択したフレーム/セクション内のテキストを要件に合わせて書き直す。文章のボリューム調整、LP限定の行動経済学的説得軸にも対応。レイアウト・色・構造は一切変更しない",
  },
  {
    name: "create-multi-pattern",
    desc: "複数レイアウトパターンを一括生成・比較。BRIEF を渡すことでより精緻な画面を生成可能。cognitive-ui-design と連携したトポロジーモデル割当にも対応",
  },
  {
    name: "create-single-page",
    desc: "`create-multi-pattern`の無質問版。全て決定的なルールで自動確定し、単一ページを一発生成。質問を一切出さないため、連続プロンプトに繋げて無人実行できる",
  },
  {
    name: "japanese-lp-seasoning",
    desc: "フルブリード演出・カルーセル/バナースライダー・縦書きを、静的フレームでの見た目として選択・提案（スクロール連動アニメーションは対象外）、簡易実装処理まで",
  },
  {
    name: "figma-typescale",
    desc: "ベースサイズと比率を聞き、タイプスケールを生成。命名規則を「オリジナル」と「Tailwind」から選択可能。オリジナルはText Styleも作成、Tailwindは変数のみ",
  },
  {
    name: "figma-tokenize",
    desc: "変数を使わずに値を直接ハードコードしている色・フォントサイズ・スペーシングを変数（トークン）化してバインド。テキストのスタイル化にも対応",
  },

  {
    name: "figma-componentize",
    desc: "選択フレーム内の繰り返しパターン（ボタン・カード等）を検出してコンポーネント化を提案。バリアント生成、バリアントの変数化までを対話的に実行",
  },
  {
    name: "figma-systematize",
    desc: "選択フレームを「レイヤー名整理 → トークン化 → コンポーネント化」の3段パイプラインで一括処理。冒頭で実行モード（自動／各ステップ確認あり）を1回だけ確認",
  },
  {
    name: "figma-enhance",
    desc: "すでにトークン化・コンポーネント化済みのファイルをページ全体で監査し、さらなる改善点を検出・提案・実装まで自動で実行",
  },
  {
    name: "figma-contrast-check",
    desc: "選択フレーム内のテキストのWCAGコントラスト比（AA/AAA）を判定し、コンパクトなレポートを出力（詳細表示可）。自動修正にも対応",
  },
];

const steps = [
  {
    n: "01",
    title: "SKILL.mdを登録",
    desc: "Figma のカスタムスキル登録機能で、使いたいスキルの SKILL.md を登録します。",
  },
  {
    n: "02",
    title: "対象を選択",
    desc: "キャンバス上で対象のフレームまたはセクションを選択します（スキルによって対象が異なります）。",
  },
  {
    n: "03",
    title: "チャットから実行",
    desc: "チャットからスキル名を呼び出すだけで実行されます。確認・質問・レポートはすべて日本語で表示されます。",
  },
];

const combos = [
  {
    goal: "新しいページを一から作りたい",
    chain: ["brief-me", "create-multi-pattern"],
    desc: "要件をヒアリングしてBRIEFを作成後、それを引き継いで複数レイアウト案を一括生成。1案でよければ`create-single-page`（無質問・一発生成）に差し替え可能です。",
  },
  {
    goal: "色や数値を変数化、コンポーネント化まで進めたい",
    chain: ["figma-tokenize", "figma-componentize"],
    desc: "ハードコードされた色をまず変数化し、繰り返しパターンをコンポーネント化候補として提案。この2段階を一括で行いたい場合は`figma-systematize`が便利です。",
  },
  {
    goal: "ページ全体を整理して仕上げまで持っていきたい",
    chain: ["figma-systematize", "figma-enhance"],
    desc: "レイヤー名整理・トークン化・コンポーネント化を3段パイプラインで一括処理したうえで、さらなる改善点をページ全体から検出・提案・実装します。",
  },
  {
    goal: "要件に沿ってコピーを書き直したい",
    chain: ["brief-me", "rewrite-me"],
    desc: "ヒアリングしたBRIEFをそのまま引き継いで、選択したフレーム内のテキストを要件に合わせて書き直します。レイアウトや構造は変更しません。",
  },
  {
    goal: "実装前にAIが読み取りやすい構造か確認したい",
    chain: ["figma-layer-rename", "figma-audit"],
    desc: "自動生成レイヤー名を先に整理してから、実装精度を4観点で採点。コンポーネント単体を見たい場合は`figma-component-audit`に差し替えます。",
  },
  {
    goal: "色のアクセシビリティを確認・修正したい",
    chain: ["figma-contrast-check"],
    desc: "選択フレーム内テキストのWCAGコントラスト比をAA/AAAで判定し、コンパクトなレポートを出力。そのまま自動修正まで依頼することもできます。",
  },
  {
    goal: "人間の特性を考慮したページデザインにしたい",
    chain: ["create-multi-pattern"],
    claudeSkill: "cognitive-ui-design",
    desc: "視線誘導パターン（Z型・F型・バナーブラインドネス回避など）や認知バイアスを踏まえたレイアウト設計は、通常版限定の`cognitive-ui-design`が担当。Figma版の`create-multi-pattern`と組み合わせることで、生成する複数パターンの質をさらに引き上げられます。",
  },
  {
    goal: "日本語の処理を改善したい",
    chain: ["rewrite-me"],
    claudeSkill: "japanese-web-guideline",
    desc: "禁則処理・斜体回避・見出しの整列など日本語特有の実装ガイドラインは、通常版限定の`japanese-web-guideline`が担当。Figma版の`rewrite-me`で整えた文言を、実装時にさらに日本語表示へ最適化できます。",
  },
];

const totalSkills = skills.length;
---

<Layout title="KMRVID Figma Skills — Figma Design Agent専用カスタムスキル集">
  <header
    class="top-0 z-40 sticky bg-canvas/95 backdrop-blur-sm border-border border-b"
  >
    <div
      class="flex justify-between items-center gap-4 mx-auto px-6 py-4 max-w-6xl"
    >
      <a href="/figma" class="font-heading text-ink leading-none">
        <span class="block text-base tracking-tight">KMRVID</span>
        <span
          class="block text-ink-soft text-xs uppercase leading-tight tracking-loose"
        >
          Figma Skills
        </span>
      </a>

      <nav aria-label="メインナビゲーション" class="hidden md:block">
        <ul
          class="flex items-center gap-8 **:hover:text-accent text-sm **:transition-colors"
        >
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={PURCHASE_URL}
          class="inline-flex items-center gap-1.5 bg-accent shadow-xs hover:brightness-110 px-4 py-2.5 rounded-full min-h-11 font-medium text-white text-sm whitespace-nowrap transition"
        >
          3,300円で申し込む
        </a>

        <button
          type="button"
          id="menu-toggle"
          aria-label="メニューを開く"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden flex justify-center items-center min-w-11 min-h-11 text-ink"
        >
          <Menu size={24} stroke-width={1.75} />
        </button>
      </div>
    </div>
  </header>

  <div
    id="mobile-menu"
    class="hidden top-0 right-0 bottom-0 left-0 z-50 fixed bg-ink"
    role="dialog"
    aria-modal="true"
    aria-label="ナビゲーションメニュー"
  >
    <div class="flex justify-between items-center px-6 py-4">
      <span class="font-heading text-canvas text-base leading-none">
        KMRVID
      </span>
      <button
        type="button"
        id="menu-close"
        aria-label="メニューを閉じる"
        class="flex justify-center items-center min-w-11 min-h-11 text-canvas"
      >
        <X size={24} stroke-width={1.75} />
      </button>
    </div>
    <nav aria-label="モバイルナビゲーション">
      <ul
        class="flex **:flex flex-col **:items-center px-6 *:border-white/10 *:border-b **:min-h-14 **:text-canvas **:text-base"
      >
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <div class="px-6 py-6">
        <a
          href={PURCHASE_URL}
          class="flex justify-center items-center gap-1.5 bg-accent hover:brightness-110 px-6 py-3.5 rounded-full w-full font-medium text-white transition"
        >
          3,300円で申し込む
        </a>
      </div>
    </nav>
  </div>

  <main id="top">
    <!-- ============ HERO ============ -->
    <section
      aria-labelledby="hero-heading"
      class="relative pt-14 md:pt-20 pb-0 overflow-hidden"
    >
      <div class="mx-auto px-6 max-w-5xl">
        <a
          href="#pricing"
          class="inline-flex items-center gap-2 mb-8 px-4 py-2 rounded-full font-medium text-sm bg-accent-soft text-accent-dark"
        >
          <BadgePercent size={16} stroke-width={2} />
          値上げ前 最終ご案内（〜8月9日 23:59）
        </a>

        <p class="mb-4 text-ink-soft text-sm uppercase tracking-widest">
          Figma Design Agent 専用カスタムスキル集
        </p>

        <h1
          id="hero-heading"
          class="max-w-3xl text-ink max-sm:text-3xl text-left"
        >
          Figmaを
          <span class="text-accent">開いたまま</span>、
          <br />
          実装精度を上げていく
        </h1>

        <p
          class="mt-6 max-w-2xl text-ink-soft text-base text-justify leading-relaxed"
        >
          「KMRVID Claude Skills」に含まれるスキルを、FigmaのDesign
          Agent（カスタムスキル登録機能）でそのまま動くように移植した専用パッケージです。URLの貼り付けもチャットの往復も最小限に、新規のページ生成だけでなく、キャンバス上の選択だけでレイヤー整理・トークン化・コンポーネント化まで、ほぼ全自動で完結できます。収録スキルの解説動画付き（8本／2026年8月3日現在）。
        </p>

        <div
          class="flex sm:flex-row flex-col items-start sm:items-center gap-4 mt-8"
        >
          <a
            href={PURCHASE_URL}
            class="inline-flex items-center gap-2 bg-accent shadow-xs hover:brightness-110 px-6 py-3.5 rounded-full font-medium text-white transition"
          >
            3,300円で受講をはじめる
            <ArrowRight size={18} stroke-width={2} />
          </a>
          <a
            href="#diff"
            class="inline-flex items-center gap-2 hover:bg-surface-alt px-6 py-3.5 border border-ink/15 rounded-full font-medium text-ink transition"
          >
            通常版との違いを見る
          </a>
        </div>

        <a
          href="https://x.com/cipher/status/2083645472091279452"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 mt-6 min-h-11 text-ink-soft hover:text-accent text-sm underline underline-offset-4 transition"
        >
          デザイン生成・最適化・実装、3本の実例をXで読む
          <ExternalLink size={14} stroke-width={2} />
        </a>
      </div>

      <!-- Bottom-up payload: numeral block + supporting image -->
      <div class="bg-ink mt-14 md:mt-20 text-canvas">
        <div
          class="items-center gap-10 grid grid-cols-1 md:grid-cols-[1fr_1.1fr] mx-auto px-6 py-12 md:py-16 max-w-5xl"
        >
          <div class="text-left">
            <div class="gap-8 grid grid-cols-2">
              <div>
                <p
                  class="flex items-baseline gap-2 font-heading text-6xl md:text-7xl"
                >
                  {totalSkills}
                  <span class="font-body text-white/50 text-lg">個</span>
                </p>
                <p class="mt-2 text-white/60 text-sm">収録スキル数</p>
              </div>
              <div>
                <p
                  class="flex items-baseline gap-2 font-heading text-6xl md:text-7xl"
                >
                  {totalSkills}
                  <span class="font-body text-white/50 text-lg">個</span>
                </p>
                <p class="mt-2 text-white/60 text-sm">
                  Figma実機動作確認済み（2026/8/6時点）
                </p>
              </div>
            </div>
            <p class="mt-8 text-white/50 text-sm">
              2026/8/6 更新
              —新スキル「figma-component-audit」を追加。既存スキルの調整
              <br />
              2026/8/5 更新 — 新スキル「design-brief-me」「create-single-page」「figma-systematize」「figma-enhance」を追加。既存スキルの調整
              <br />
              2026/8/4 更新 — 新スキル「figma-contrast-check」「figma-typescale」を追加。既存スキルの調整
            </p>
          </div>

          <figure
            class="border border-white/10 rounded-2xl aspect-video overflow-hidden"
          >
            <Image
              src={figmaWireframe}
              alt="MacBookの画面に表示されたワイヤーフレームデザイン"
              width={1200}
              height={800}
              class="w-full h-full object-cover"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ DIFFERENCES ============ -->
    <section
      id="diff"
      aria-labelledby="diff-heading"
      class="mx-auto px-6 py-20 md:py-28 max-w-5xl"
    >
      <h2 id="diff-heading" class="max-w-xl text-ink text-left">
        通常版と何が違うのか
      </h2>
      <p
        class="mt-4 max-w-xl text-ink-soft text-base text-justify leading-relaxed"
      >
        「KMRVID Claude
        Skills」に含まれる同名スキルのFigma専用版。中身のロジックは同じでも、Figma上で問題なく動くように前提から作り直し最適化しています。
      </p>

      <div
        class="*:flex *:flex-col gap-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 *:bg-canvas mt-10 *:p-6 *:border *:border-border *:rounded-2xl"
      >
        {
          differences.map((item) => (
            <div>
              <item.icon size={22} stroke-width={1.75} class="text-accent" />
              <h3 class="mt-4 min-h-14 text-lg text-left leading-snug">
                {item.title}
              </h3>
              <p class="flex-1 mt-2 text-ink-soft text-base text-justify leading-snug">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-ink-soft text-sm text-justify leading-snug">
        ライセンスは全スキル共通でkmrvid.com講座参加者限定の利用規約です（各フォルダのLICENSEを参照）。
      </p>

      <div class="mt-6">
        <Callout>
          `cognitive-ui-design`と`japanese-web-guideline`スキルは、通常版の「KMRVID
          Claude
          Skills」に含まれるスキルで、Figma専用版には含まれません。レイアウトの定石崩しや日本語Web実装の補正などのガイドラインは、その内容が重要であるため通常版のみでの提供です。
        </Callout>
      </div>
    </section>

    <!-- ============ SKILLS GRID ============ -->
    <section
      id="skills"
      aria-labelledby="skills-heading"
      class="bg-surface-alt py-20 md:py-28"
    >
      <div class="mx-auto px-6 max-w-5xl">
        <h2 id="skills-heading" class="max-w-xl text-ink text-left">
          収録{totalSkills}スキル
        </h2>
        <p
          class="mt-4 max-w-xl text-ink-soft text-base text-justify leading-relaxed"
        >
          Figmaのキャンバス上で選択して呼び出すだけで動く、{
            totalSkills
          }個のカスタムスキルです。
        </p>

        <div
          class="*:flex *:flex-col gap-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 *:bg-canvas mt-10 *:p-6 *:border *:border-border *:rounded-2xl"
        >
          {
            skills.map((skill) => (
              <div>
                <p class="font-mono font-bold text-base text-left leading-snug">
                  {skill.name}
                </p>
                <p class="flex-1 mt-2 text-ink-soft text-base text-justify leading-snug">
                  {skill.desc}
                </p>
              </div>
            ))
          }
        </div>

        <p class="mt-6 text-ink-soft text-sm">
          2026/8/6時点で、{
            totalSkills
          }スキルすべてFigma上での実機動作を確認済みです。利用環境やツールのバージョンによっては、正常に動作しない場合があります。
        </p>
      </div>
    </section>

    <!-- ============ HOW TO USE ============ -->
    <section
      id="how-to"
      aria-labelledby="how-to-heading"
      class="mx-auto px-6 py-20 md:py-28 max-w-5xl"
    >
      <div
        class="flex items-center gap-2 mb-4 text-ink-soft text-sm uppercase tracking-widest"
      >
        <Workflow size={18} stroke-width={2} />
        使い方
      </div>
      <h2 id="how-to-heading" class="max-w-xl text-ink text-left">
        3ステップで動かせる
      </h2>

      <ol class="gap-6 grid grid-cols-1 sm:grid-cols-3 mt-10">
        {
          steps.map((step) => (
            <li class="bg-canvas p-6 border border-border rounded-2xl">
              <p class="font-heading text-accent text-3xl">{step.n}</p>
              <h3 class="mt-3 text-lg text-left leading-snug">{step.title}</h3>
              <p class="mt-2 text-ink-soft text-base text-justify leading-snug">
                {step.desc}
              </p>
            </li>
          ))
        }
      </ol>

      <div class="flex flex-col gap-4 mt-10">
        <Callout>
          `brief-me` → `create-multi-pattern` または `rewrite-me`
