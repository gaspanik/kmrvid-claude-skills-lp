---
interface Props {
  goal: string;
  chain: string[];
  desc: string;
}

const { goal, chain, desc } = Astro.props;
---

<div class="flex flex-col bg-canvas p-6 border border-border rounded-2xl">
  <h3 class="text-lg text-left leading-snug">{goal}</h3>
  <ol class="flex flex-wrap items-center gap-2 mt-4">
    {
      chain.map((name, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && (
            <span aria-hidden="true" class="text-ink-soft">
              →
            </span>
          )}
          <span class="bg-surface-alt px-2.5 py-1 rounded-full font-mono text-sm">
            {name}
          </span>
        </li>
      ))
    }
  </ol>
  <p class="mt-3 text-ink-soft text-base text-justify leading-snug">{desc}</p>
</div>
