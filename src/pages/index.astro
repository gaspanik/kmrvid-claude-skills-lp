---
import { ArrowRight, BookOpen, ExternalLink, GraduationCap } from "@lucide/astro";
import { Image } from "astro:assets";
import authorPhoto from "@/assets/images/IMG_8341_square.png";
import deskKeyboardDark from "@/assets/images/desk-keyboard-dark.jpg";
import laptopWork from "@/assets/images/laptop-work.jpg";
import ChangelogList from "@/components/ChangelogList.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Price from "@/components/Price.astro";
import Layout from "@/layouts/Layout.astro";
import { changelogSorted } from "@/data/changelog";
import { desktopSkillsCount } from "@/data/desktop";
import { museSkillsCount } from "@/data/muse";
import {
  claudeSkillsCount,
  figmaSkillsCount,
  totalSkills,
} from "@/data/skills";
import { type ProductKey, products } from "@/data/products";

const BOOKS_URL = "https://www.amazon.co.jp/stores/author/B008Q05NQW/allbooks";

const socialLinks = [
  { label: "X", href: "https://x.com/cipher/" },
  { label: "Facebook", href: "https://www.facebook.com/gaspanik" },
  { label: "GitHub", href: "https://github.com/gaspanik" },
  { label: "Instagram", href: "https://www.instagram.com/cipher" },
  { label: "YouTube", href: "https://www.youtube.com/@kmrvid" },
];

const productCards: {
  key: ProductKey;
  title: string;
  desc: string;
}[] = [
  {
    key: "bundle",
    title: "Claude版とFigma版をまとめて",
    desc: `Claude Code用${claudeSkillsCount}個とFigma Design Agent用${figmaSkillsCount}個の全${totalSkills}スキルに、解説動画${products.bundle.videos}本。Muse版も特典で付きます。`,
  },
  {
    key: "claude",
    title: "Claude Code で動かす",
    desc: "セットアップ、モックアップ作成、Figma連携、Tailwind最適化、仕上げまでをカバーするスキル群。Muse版も特典で付きます。",
  },
  {
    key: "figma",
    title: "Figma Design Agent で動かす",
    desc: "Figmaの中で、整理・変数化・コンポーネント化・監査までを行うカスタムスキル集。Muse版も特典で付きます。",
  },
  {
    key: "muse",
    title: "Muse のチャットで動かす",
    desc: "Museのチャットでスキル名を伝えるだけ。Figmaコネクタ経由で、Figma AIクレジットを使わずに実行できます。時間指定のバックグラウンド実行にも対応します。",
  },
  {
    key: "desktop",
    title: "Claude Desktop のチャットで動かす",
    desc: "Claude Desktopのチャットにプラグインとして登録。Muse版とほぼ同じスキルを、リファレンスファイルつきで使えます。時間指定のバックグラウンド実行にも対応します。",
  },
];

const aboutPoints = [
  {
    title: "スキルとは",
    desc: "「この作業はこの手順で」とAIに覚えさせておく指示書です。毎回プロンプトを書き直さなくても、名前を呼ぶだけで同じ品質の作業を再現できます。",
  },
  {
    title: "実務から生まれたスキル",
    desc: "Web制作の現場で繰り返してきた作業を、そのままスキルの形にしました。レイヤー整理、変数化、モックアップ作成、コードのレビューなどが対象です。",
  },
  {
    title: "環境ごとに最適化",
    desc: "Claude Code、Figma Design Agent、Muse、Claude Desktop。それぞれの環境で動くように調整した版を用意しています。",
  },
];

const recent = changelogSorted
  .filter((entry) => entry.ja !== undefined)
  .slice(0, 5);
---

<Layout
  title="KMRVID Skills — Claude Code・Figma・Muse・Claude Desktop向けオリジナルスキル講座"
  description={`Web制作の実務から生まれたオリジナルスキルを、Claude Code・Figma Design Agent・Muse・Claude Desktopの環境別に提供。全${totalSkills + museSkillsCount + desktopSkillsCount}スキル、買い切りの講座です。`}
  translated
>
  <Header />

  <main id="top">
    <!-- ============ HERO ============ -->
    <section aria-labelledby="hero-heading" class="relative pt-14 md:pt-20 pb-0 overflow-hidden">
      <div class="items-center gap-10 grid grid-cols-1 md:grid-cols-[1.5fr_1fr] mx-auto px-6 max-w-5xl">
        <div>
          <p class="mb-4 text-ink-soft text-sm uppercase tracking-widest">
        KMRVID Skills
      </p>
      <h1 id="hero-heading" class="max-w-3xl text-ink max-sm:text-2xl text-balance text-left">
        AIには、
        <br class="sm:hidden" />
        毎回"指示"するより
        <br />
        <span class="text-accent">"スキル"</span>を渡した方が速い
      </h1>
      <p class="mt-6 max-w-2xl text-ink-soft text-base text-justify leading-relaxed">
        Web制作の実務から生まれたオリジナルスキルを、お使いの環境に合わせてお選びいただけます。まずは環境にあった商品をご覧ください。
      </p>
        </div>
        <div class="border border-border rounded-3xl overflow-hidden">
          <Image
            src={deskKeyboardDark}
            alt=""
            width={960}
            height={1200}
            loading="eager"
            class="w-full h-full max-md:max-h-80 object-cover"
          />
        </div>
      </div>

      <div class="bg-ink mt-14 md:mt-20 text-canvas">
        <div class="gap-8 grid grid-cols-1 sm:grid-cols-3 mx-auto px-6 py-12 md:py-16 max-w-5xl text-left">
          <div>
            <p class="flex items-baseline gap-2 font-heading text-6xl md:text-7xl">4<span class="font-body text-white/50 text-lg">環境</span></p>
            <p class="mt-2 text-white/60 text-sm">Claude Code・Figma・Muse・Claude Desktop</p>
          </div>
          <div>
            <p class="flex items-baseline gap-2 font-heading text-6xl md:text-7xl">5<span class="font-body text-white/50 text-lg">商品</span></p>
            <p class="mt-2 text-white/60 text-sm">環境ごとの単体版と、ClaudeとFigmaのBundle</p>
          </div>
          <div>
            <p class="flex items-baseline gap-2 font-heading text-6xl md:text-7xl">{totalSkills}<span class="font-body text-white/50 text-lg">個</span></p>
            <p class="mt-2 text-white/60 text-sm">Bundleに収録のスキル数</p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="products"
      aria-labelledby="products-heading"
      class="mx-auto px-6 py-16 md:py-20 max-w-5xl"
    >
      <h2 id="products-heading" class="max-w-xl text-ink text-left">
        環境にあわせて選ぶ
      </h2>
      <ul class="gap-6 grid grid-cols-1 md:grid-cols-2 mt-10">
        {
          productCards.map((card) => {
            const product = products[card.key];
            return (
              <li
                class:list={[
                  "flex flex-col bg-canvas p-6 border border-border rounded-2xl",
                  card.key === "bundle" && "md:col-span-2",
                ]}
              >
                <p class="text-ink-soft text-sm uppercase tracking-wide">
                  {product.env}
                </p>
                <h3 class="mt-1 text-xl text-left leading-snug">
                  {product.name}
                </h3>
                <p class="mt-1 text-accent-dark text-sm">{card.title}</p>
                <p class="flex-1 mt-3 text-ink-soft text-base text-justify leading-snug">
                  {card.desc}
                </p>
                <p class="mt-4 text-ink-soft text-sm">
                  {product.skills}スキル ・{" "}
                  <span class="font-heading text-ink text-xl">
                    <Price product={card.key} />円
                  </span>
                  <span class="ml-1">税込・買い切り</span>
                  {product.campaign && (
                    <span class="campaign-ended:hidden ml-2 bg-accent-soft px-2.5 py-0.5 rounded-full font-medium text-accent-dark">
                      発売記念価格 {product.campaign.endsAtShort}まで
                    </span>
                  )}
                </p>
                <a
                  href={product.href}
                  class="inline-flex items-center gap-1.5 mt-4 min-h-11 text-ink hover:text-accent text-sm underline underline-offset-4 transition"
                >
                  詳細を見る
                  <ArrowRight size={14} stroke-width={2} />
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section aria-label="コンセプト" class="relative py-20 md:py-28 overflow-hidden text-canvas">
      <Image
        src={laptopWork}
        alt=""
        width={1920}
        height={1080}
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-ink/80"></div>
      <div class="z-10 relative mx-auto px-6 max-w-5xl">
        <p class="max-w-4xl font-heading text-2xl md:text-3xl text-left leading-snug">
          実務の現場から生まれたスキルを、<br class="max-sm:hidden" />環境ごとに最適化して。
        </p>
        <p class="mt-4 max-w-3xl text-white/70 text-base text-balance text-left leading-relaxed">
          同じ作業を、Claude Code・Figma・Muse・Claude Desktopのどこでも同じ品質で。<br class="max-sm:hidden" />Muse版とClaude Desktop版は、時間指定のバックグラウンド実行も可能です。
        </p>
      </div>
    </section>

    <!-- ============ ABOUT THE SKILLS ============ -->
    <section
      id="skills"
      aria-labelledby="skills-heading"
      class="py-20 md:py-28"
    >
      <div class="mx-auto px-6 max-w-5xl">
        <h2 id="skills-heading" class="max-w-xl text-ink text-left">
          各スキルについて
        </h2>
        <div
          class="*:flex *:flex-col gap-6 grid grid-cols-1 md:grid-cols-3 mt-10 *:bg-canvas *:p-6 *:border *:border-border *:rounded-2xl"
        >
          {
            aboutPoints.map((point) => (
              <div>
                <h3 class="text-lg text-left leading-snug">{point.title}</h3>
                <p class="mt-2 text-ink-soft text-base text-justify leading-snug">
                  {point.desc}
                </p>
              </div>
            ))
          }
        </div>
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-8">
          <li>
            <a
              href="/skills/"
              class="inline-flex items-center gap-1 min-h-11 text-ink hover:text-accent text-sm underline underline-offset-4 transition"
            >
              Claude版・Figma版の全スキル一覧（{totalSkills}スキル）
              <ArrowRight size={14} stroke-width={2} />
            </a>
          </li>
          <li>
            <a
              href="/muse/#skills"
              class="inline-flex items-center gap-1 min-h-11 text-ink hover:text-accent text-sm underline underline-offset-4 transition"
            >
              Muse版のスキル（{museSkillsCount}スキル）
              <ArrowRight size={14} stroke-width={2} />
            </a>
          </li>
          <li>
            <a
              href="/desktop/#skills"
              class="inline-flex items-center gap-1 min-h-11 text-ink hover:text-accent text-sm underline underline-offset-4 transition"
            >
              Desktop版のスキル（{desktopSkillsCount}スキル）
              <ArrowRight size={14} stroke-width={2} />
            </a>
          </li>
        </ul>
      </div>
    </section>

    <!-- ============ AUTHOR CREDIBILITY ============ -->
    <section
      id="author"
      aria-labelledby="author-heading"
      class="bg-surface-alt py-20 md:py-28"
    >
      <div class="mx-auto px-6 max-w-5xl">
        <div class="max-w-2xl">
          <p
            class="flex items-center gap-2 mb-4 text-ink-soft text-sm uppercase tracking-widest"
          >
            <GraduationCap size={18} stroke-width={2} />
            講師紹介
          </p>
          <h2 id="author-heading" class="text-ink text-left">こもりまさあき</h2>
          <p class="mt-4 text-ink-soft text-base text-justify leading-relaxed">
            1990年代前半、都内のDTP系デザイン会社でアルバイトを始め、大学卒業後にそのまま正社員として入出力・デザイン・ネットワーク関連の業務に従事。2001年に独立し、以降フリーランスとして活動を続けている。
          </p>
          <p class="mt-4 text-ink-soft text-base text-justify leading-relaxed">
            案件ごとに担う役割が異なるため、単一の職域的な肩書きは持たない。Web制作関連書籍の執筆を多数手がける一方、近年はフロントエンド周りの制作業務に関わりながら、Figmaの企業研修講師やデザインシステム構築、Shopifyの運用サポート、コンサルティングなど幅広く活動中。本講座のスキル群も、こうした実務の中から生まれたものをそのまま形にしている。
          </p>

          <a
            href={BOOKS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 mt-6 min-h-11 text-ink-soft hover:text-accent text-sm underline underline-offset-4 transition"
          >
            <BookOpen size={16} stroke-width={2} />
            これまでの執筆・監修書籍一覧（Amazon）
          </a>

          <ul class="flex flex-wrap gap-2 mt-4">
            {
              socialLinks.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 bg-canvas px-3 py-1.5 border border-border hover:border-accent rounded-full min-h-11 text-ink-soft hover:text-accent text-xs leading-tight transition"
                  >
                    {social.label}
                    <ExternalLink size={12} stroke-width={2} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- bottom weight: photo + pull-quote -->
        <div
          class="items-start md:items-center gap-8 grid grid-cols-1 md:grid-cols-[auto_1fr] mt-14 max-w-3xl"
        >
          <div
            class="border border-border rounded-full w-36 md:w-44 aspect-square overflow-hidden shrink-0"
          >
            <Image
              src={authorPhoto}
              alt="著者 こもりまさあきのプロフィール写真"
              width={400}
              height={400}
              class="w-full h-full object-cover"
            />
          </div>
          <blockquote class="relative pl-8">
            <span
              class="top-0 left-0 absolute font-heading text-accent text-4xl leading-none select-none"
              aria-hidden="true"
            >
              "
            </span>
            <p class="font-heading text-xl md:text-2xl text-left leading-snug">
              プロンプトを書く技術ではなく、AIと働くための「仕組み」を作る技術を届けたい。
            </p>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ============ CHANGELOG ============ -->
    <section
      id="changelog"
      aria-labelledby="changelog-heading"
      class="mx-auto px-6 py-20 md:py-28 max-w-3xl"
    >
      <h2 id="changelog-heading" class="text-ink text-left">更新履歴</h2>
      <ChangelogList entries={recent} lang="ja" />
      <a
        href="/changelog/"
        class="inline-flex items-center gap-1.5 mt-6 min-h-11 text-ink hover:text-accent text-sm underline underline-offset-4 transition"
      >
        すべての更新履歴を見る
        <ArrowRight size={14} stroke-width={2} />
      </a>
    </section>
  </main>

  <Footer />
</Layout>
