---
// design-preview.astro — generated by export-design-md skill from DESIGN.md
// Token values (colors, spacing, etc.) are read from DESIGN.md at build time — do NOT hardcode them.

import { readFileSync } from 'node:fs';
import * as yaml from 'js-yaml';
import Layout from '../layouts/Layout.astro';

// Read DESIGN.md tokens at build time — values stay in sync with DESIGN.md
const raw = readFileSync('./DESIGN.md', 'utf-8');
const match = raw.match(/^---\n([\s\S]*?)\n---/);
const tokens: any = match ? yaml.load(match[1]) : {};
const { colors = {}, typography = {}, rounded = {}, spacing = {}, components = {} } = tokens as any;

// Resolve token references: "{colors.primary}" → actual hex value
const r = (v: any): string => {
  if (typeof v === 'string' && v.startsWith('{') && v.endsWith('}')) {
    return v.slice(1, -1).split('.').reduce((o: any, k: string) => o?.[k], tokens) ?? v;
  }
  return String(v ?? '');
};

const title = `${tokens.name ?? 'Project'} Design System`;
const description = tokens.description ?? '';
const generatedDate = '2026-07-24';

const typographySampleText: Record<string, string> = {
  h1: 'Heading sample',
  h2: 'Heading sample',
  h3: 'Heading sample',
  'body-md': '本文サンプル。読みやすさを優先し、ゆったりとした行間で構成する。',
  'label-md': 'Label sample',
  caption: 'Caption sample',
};
const typographyEntries = Object.entries(typography) as [string, any][];
---

<Layout title={title}>
  <div class="bg-surface-alt text-ink antialiased">
    <!-- Header -->
    <header class="top-0 z-10 sticky bg-white border-border border-b">
      <div
        class="flex flex-col gap-3 mx-auto px-6 py-4 max-w-4xl md:flex-row md:items-center md:justify-between md:gap-4"
      >
        <span class="font-semibold text-lg tracking-wide">{tokens.name}</span>
        <nav aria-label="Section navigation">
          <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-ink-soft text-sm md:gap-x-6 md:text-base">
            <li>
              <a href="#colors" class="hover:text-ink transition-colors"
                >Colors</a>
            </li>
            <li>
              <a
                href="#typography"
                class="hover:text-ink transition-colors">Typography</a>
            </li>
            <li>
              <a href="#spacing" class="hover:text-ink transition-colors"
                >Spacing</a>
            </li>
            <li>
              <a href="#shapes" class="hover:text-ink transition-colors"
                >Shapes</a>
            </li>
            <li>
              <a
                href="#components"
                class="hover:text-ink transition-colors">Components</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main class="mx-auto px-6 py-12 max-w-4xl">
      <!-- Breadcrumb -->
      <p class="mb-8 text-ink-soft text-sm">
        ← <a href="/" class="hover:text-ink transition-colors"
          >Back to project</a
        >
      </p>

      <!-- Article header -->
      <div class="mb-10">
        <span
          class="inline-block bg-surface-alt mb-4 px-3 py-1 rounded-full font-medium text-ink-soft text-xs leading-tight uppercase tracking-widest"
          >Design System</span
        >
        <h1 class="mb-4 font-medium text-4xl leading-none">
          {tokens.name}<br />Design System
        </h1>
        <p class="text-ink-soft text-base leading-snug">{description}</p>
        <p class="mt-3 text-ink-soft text-sm">Generated {generatedDate}</p>
      </div>

      <hr class="mb-12 border-border" />

      <!-- Overview -->
      <section class="mb-16">
        <p class="font-medium text-ink-soft text-base">
          実務歴の長いWeb制作者が講師を務める、Claude Code向けスキル講座の販促LP。誇張のない落ち着いた説得トーンで、実績と網羅性（36スキル・31本の動画）を静かに裏付けとして提示する。ターゲットはFigma・コーディングを日常的に行うWeb制作者/フリーランスと、AI導入を検討する制作会社の意思決定者で、双方に「実務でそのまま使える」信頼感を与える必要がある。装飾は最小限にとどめ、単色（モノクローム）の地に一色のアクセントだけを効かせるエディトリアルな雰囲気とする。
        </p>
      </section>

      <!-- 01 Colors -->
      <section id="colors" class="mb-16">
        <div class="flex items-baseline gap-3 mb-6">
          <span
            class="font-medium text-ink-soft text-xs leading-tight uppercase tracking-widest"
            >01</span
          >
          <h2 class="font-normal text-2xl">Colors</h2>
        </div>

        <div class="gap-4 grid grid-cols-2 md:grid-cols-4 mb-8">
          {
            Object.entries(colors).map(([key, value]) => (
              <div>
                <div style={`background:${r(value)};height:7rem;border-radius:0.75rem;border:1px solid #e5e7eb;`} />
                <p class="mt-2 font-medium text-sm capitalize">{key}</p>
                <p class="font-mono text-ink-soft text-xs leading-tight">{r(value)}</p>
              </div>
            ))
          }
        </div>

        <p class="text-ink-soft text-sm leading-7">
          モノクローム＋単一アクセントの構成。背景・本文は白と墨色に絞り、赤みのテラコッタ系アクセントをCTAとハイライトにのみ使うことで、誇大な印象を避けつつ視線を導く。Primary(#d3401f)はCTAボタン・リンクホバー・価格訴求などの主要アクセント、Secondary(#a92e14)はバッジ・コールアウトの文字色、Tertiary(#f7e2d9)はその背景色として使用する。
        </p>
      </section>

      <!-- 02 Typography -->
      <section id="typography" class="mb-16">
        <div class="flex items-baseline gap-3 mb-6">
          <span
            class="font-medium text-ink-soft text-xs leading-tight uppercase tracking-widest"
            >02</span
          >
          <h2 class="font-normal text-2xl">Typography</h2>
        </div>

        <div class="flex flex-col gap-8 mb-8">
          {
            typographyEntries.map(([key, val], i) => (
              <div class={i < typographyEntries.length - 1 ? 'pb-6 border-border border-b' : ''}>
                <p class="mb-3 font-mono text-ink-soft text-xs leading-tight">
                  {key} — {val.fontFamily} / {val.fontSize} / {val.fontWeight}
                  {val.letterSpacing ? ` / ls ${val.letterSpacing}` : ''}
                </p>
                <p
                  style={`font-family:${val.fontFamily};font-size:${val.fontSize};font-weight:${val.fontWeight};line-height:${val.lineHeight ?? 'normal'};letter-spacing:${val.letterSpacing ?? 'normal'};`}
                >
                  {typographySampleText[key] ?? 'Sample text'}
                </p>
              </div>
            ))
          }
        </div>

        <p class="text-ink-soft text-sm leading-7">
          見出しは「Gen Interface JP Display」、本文は「Gen Interface JP」を使用し、両者を明確に書き分ける。見出しは行間を詰めて（line-height 1.1）力強さを出し、本文は読みやすさを優先して1.6程度のゆったりした行間を確保する。日本語の可読性を優先し、本文・説明文はtext-justify（両端揃え）で整える。
        </p>
      </section>

      <!-- 03 Spacing -->
      <section id="spacing" class="mb-16">
        <div class="flex items-baseline gap-3 mb-6">
          <span
            class="font-medium text-ink-soft text-xs leading-tight uppercase tracking-widest"
            >03</span
          >
          <h2 class="font-normal text-2xl">Spacing</h2>
        </div>

        <div class="flex flex-col gap-4">
          {
            Object.entries(spacing).map(([key, value]) => (
              <div class="flex items-center gap-4">
                <div style={`width:${r(value)};height:1rem;background:${r(colors.primary)};border-radius:2px;flex-shrink:0;`} />
                <span class="w-8 font-mono text-ink text-sm">{key}</span>
                <span class="text-ink-soft text-sm">{r(value)}</span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 04 Shapes -->
      <section id="shapes" class="mb-16">
        <div class="flex items-baseline gap-3 mb-6">
          <span
            class="font-medium text-ink-soft text-xs leading-tight uppercase tracking-widest"
            >04</span
          >
          <h2 class="font-normal text-2xl">Shapes</h2>
        </div>

        <div class="gap-6 grid grid-cols-2 md:grid-cols-4 mb-8">
          {
            Object.entries(rounded).map(([key, value]) => (
              <div class="flex flex-col items-center gap-3">
                <div style={`width:5rem;height:5rem;border-radius:${r(value)};background:linear-gradient(135deg,${r(colors.primary)},${r(colors.ink)});`} />
                <div class="text-center">
                  <p class="font-medium text-sm">{key}</p>
                  <p class="font-mono text-ink-soft text-xs leading-tight">{r(value)}</p>
                </div>
              </div>
            ))
          }
        </div>

        <p class="text-ink-soft text-sm leading-7">
          角丸は用途に応じて3段階＋フルラウンドを使い分ける。ボタン・バッジ・ピルは常にrounded-full（完全な丸み）とし、カードや画像枠はrounded-md（16px）、CTAパネルなど大きな面はrounded-lg（24px）を使う。
        </p>
      </section>

      <!-- 05 Components -->
      <section id="components" class="mb-16">
        <div class="flex items-baseline gap-3 mb-6">
          <span
            class="font-medium text-ink-soft text-xs leading-tight uppercase tracking-widest"
            >05</span
          >
          <h2 class="font-normal text-2xl">Components</h2>
        </div>

        <div class="flex flex-wrap items-start gap-6 mb-8">
          <!-- button-primary -->
          <div class="flex flex-col items-start gap-2">
            <button
              type="button"
              style={`background:${r(components['button-primary']?.backgroundColor)};color:${r(components['button-primary']?.textColor)};padding:${components['button-primary']?.padding};border-radius:${r(components['button-primary']?.rounded)};`}
              class="font-medium text-sm"
            >
              今すぐ申し込む
            </button>
            <p class="font-mono text-ink-soft text-xs leading-tight">button-primary</p>
          </div>

          <!-- button-primary-hover -->
          <div class="flex flex-col items-start gap-2">
            <button
              type="button"
              style={`background:${r(components['button-primary-hover']?.backgroundColor)};color:${r(components['button-primary']?.textColor)};padding:${components['button-primary']?.padding};border-radius:${r(components['button-primary']?.rounded)};`}
              class="font-medium text-sm"
            >
              今すぐ申し込む
            </button>
            <p class="font-mono text-ink-soft text-xs leading-tight">button-primary-hover</p>
          </div>

          <!-- button-outline -->
          <div class="flex flex-col items-start gap-2">
            <button
              type="button"
              style={`background:${r(components['button-outline']?.backgroundColor)};color:${r(components['button-outline']?.textColor)};padding:${components['button-outline']?.padding};border-radius:${r(components['button-outline']?.rounded)};border:1px solid ${r(components['button-outline']?.borderColor)};`}
              class="font-medium text-sm"
            >
              詳しく見る
            </button>
            <p class="font-mono text-ink-soft text-xs leading-tight">button-outline</p>
          </div>

          <!-- badge -->
          <div class="flex flex-col items-start gap-2">
            <span
              style={`background:${r(components.badge?.backgroundColor)};color:${r(components.badge?.textColor)};padding:${components.badge?.padding};border-radius:${r(components.badge?.rounded)};`}
              class="inline-block font-medium text-sm"
            >
              期間限定クーポン
            </span>
            <p class="font-mono text-ink-soft text-xs leading-tight">badge</p>
          </div>
        </div>

        <div class="gap-6 grid grid-cols-1 md:grid-cols-2 mb-8">
          <!-- card -->
          <div
            style={`background:${r(components.card?.backgroundColor)};border:1px solid ${r(components.card?.borderColor)};border-radius:${r(components.card?.rounded)};padding:${components.card?.padding};`}
          >
            <p class="font-medium text-sm">card</p>
            <p class="mt-2 text-ink-soft text-sm leading-relaxed">
              特徴紹介やスキル紹介のグリッドで使用するカードコンポーネント。
            </p>
          </div>

          <!-- callout -->
          <div
            style={`background:${r(components.callout?.backgroundColor)};color:${r(components.callout?.textColor)};border-radius:${r(components.callout?.rounded)};padding:${components.callout?.padding};`}
          >
            <p class="font-medium text-sm">callout</p>
            <p class="mt-2 text-sm leading-relaxed">
              強調しすぎずに補足情報を伝える注意書きコンポーネント。
            </p>
          </div>
        </div>

        <p class="text-ink-soft text-sm leading-7">
          button-primaryはPrimary背景・白文字のピル型ボタン。hover:brightness-110でわずかに明るくなる程度の控えめなインタラクション。button-outlineはSurface背景・Border罫線のセカンダリボタンで、Primaryボタンと並置する場面（ヒーローの2ボタン構成など）で使用する。cardはSurface背景・Border罫線・rounded-mdのカード。badge / calloutはTertiary背景・Secondary文字色の小さなラベル/注意書き。section-altはSurface Alt背景のセクションで、白背景セクションと交互に配置しページ全体のリズムを作る。
        </p>
      </section>

      <!-- 06 Do's and Don'ts -->
      <section id="guidelines" class="mb-16">
        <div class="flex items-baseline gap-3 mb-6">
          <span
            class="font-medium text-ink-soft text-xs leading-tight uppercase tracking-widest"
            >06</span
          >
          <h2 class="font-normal text-2xl">Do's and Don'ts</h2>
        </div>

        <div class="flex flex-col gap-3">
          <div class="flex gap-2 text-sm leading-7">
            <span class="font-bold text-green-600 shrink-0">✓</span>
            <p class="text-ink">カラーは必ずDESIGN.mdのトークン（primary/secondary/ink/mutedなど）経由で使う。</p>
          </div>
          <div class="flex gap-2 text-sm leading-7">
            <span class="font-bold text-green-600 shrink-0">✓</span>
            <p class="text-ink">本文・説明文はtext-justify、見出しはtext-leftで統一する。</p>
          </div>
          <div class="flex gap-2 text-sm leading-7">
            <span class="font-bold text-green-600 shrink-0">✓</span>
            <p class="text-ink">大文字表記が必要な場合はuppercaseクラスで表現し、テキスト自体は先頭大文字＋残り小文字で記述する。</p>
          </div>
          <div class="flex gap-2 text-sm leading-7">
            <span class="font-bold text-red-400 shrink-0">✗</span>
            <p class="text-ink">Tailwindの生カラー（gray-*、neutral-*など）をプロジェクトのパレットとして使わない。</p>
          </div>
          <div class="flex gap-2 text-sm leading-7">
            <span class="font-bold text-red-400 shrink-0">✗</span>
            <p class="text-ink">ボタンやバッジの角丸をrounded-full以外に変えない（統一感が崩れる）。</p>
          </div>
          <div class="flex gap-2 text-sm leading-7">
            <span class="font-bold text-red-400 shrink-0">✗</span>
            <p class="text-ink">誇大な演出（強いドロップシャドウ、過剰なグラデーション）を追加しない。落ち着いた実績訴求のトーンを崩す。</p>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-gray-200 border-t">
      <div
        class="flex justify-between items-center mx-auto px-6 py-6 max-w-4xl text-ink-soft text-sm"
      >
        <p>{tokens.name} Design System</p>
        <p>Generated {generatedDate}</p>
      </div>
    </footer>
  </div>
</Layout>
