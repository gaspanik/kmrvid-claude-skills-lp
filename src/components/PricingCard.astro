---
import { ArrowRight, CircleCheck } from "@lucide/astro";
import Price from "@/components/Price.astro";
import { type ProductKey, products } from "@/data/products";

interface Props {
  product: ProductKey;
  benefits: string[];
}

const { product, benefits } = Astro.props;
const { en } = products[product];
---

<div class="bg-ink mt-10 rounded-3xl overflow-hidden text-canvas">
  <div class="gap-10 grid grid-cols-1 md:grid-cols-[1.1fr_1fr] p-8 md:p-12">
    <div>
      <p class="font-heading text-6xl md:text-7xl">
        <Price product={product} lang="en" />
      </p>
      <p class="mt-2 text-white/60 text-sm">One-time purchase on Gumroad</p>
      <a
        href={en.url}
        class="inline-flex items-center gap-2 bg-accent shadow-xs hover:brightness-110 mt-8 px-6 py-3.5 rounded-full font-medium text-white transition"
      >
        <span>Buy on Gumroad</span>
        <ArrowRight size={18} stroke-width={2} />
      </a>
    </div>

    <ul
      class="flex *:flex flex-col *:[&_svg]:flex-none *:items-start gap-3 *:gap-3 *:[&_svg]:mt-0.5 md:pl-8 md:border-white/10 md:border-l text-white/80 *:[&_svg]:text-accent text-base"
    >
      {
        benefits.map((benefit) => (
          <li>
            <CircleCheck size={18} stroke-width={2} />
            <span>{benefit}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
