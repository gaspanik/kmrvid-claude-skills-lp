---
interface Props {
  question: string;
}

const { question } = Astro.props;
---

<details class="group py-5">
  <summary
    class="flex justify-between items-center gap-4 font-medium text-ink text-base cursor-pointer"
  >
    {question}
    <span class="text-ink-soft group-open:rotate-180 transition-transform">
      ▾
    </span>
  </summary>
  <p class="mt-3 pr-8 text-ink-soft text-base text-justify leading-relaxed">
    <slot />
  </p>
</details>
