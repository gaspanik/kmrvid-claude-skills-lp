---
import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";
import figmaWireframe from "@/assets/images/figma-wireframe.jpg";
import laptopWork from "@/assets/images/laptop-work.jpg";
import ChangelogList from "@/components/ChangelogList.astro";
import CreatorBio from "@/components/CreatorBio.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import { changelogSorted } from "@/data/changelog";
import { desktopSkillsCount } from "@/data/desktop";
import { museSkillsCount } from "@/data/muse";
import {
  claudeSkillsCount,
  figmaSkillsCount,
  totalSkills,
} from "@/data/skills";
import { formatUsd, type ProductKey, products } from "@/data/products";

const productCards: { key: ProductKey; title: string; desc: string }[] = [
  {
    key: "bundle",
    title: "Claude and Figma together",
    desc: `All ${totalSkills} skills: ${claudeSkillsCount} for Claude Code and ${figmaSkillsCount} for Figma’s Design Agent. The Muse edition comes as a bonus.`,
  },
  {
    key: "claude",
    title: "Runs in Claude Code",
    desc: "Skills that cover setup, mockups, Figma handoff, Tailwind cleanup and final polish. The Muse edition comes as a bonus.",
  },
  {
    key: "figma",
    title: "Runs in Figma’s Design Agent",
    desc: "Custom skills that tidy, tokenize, componentize and audit a file from inside Figma. The Muse edition comes as a bonus.",
  },
  {
    key: "muse",
    title: "Runs in the Muse chat",
    desc: "Just name the skill in the Muse chat. It works through the Figma connector, so no Figma AI credits are used.",
  },
  {
    key: "desktop",
    title: "Runs in the Claude Desktop chat",
    desc: "Registered as a plugin in the Claude Desktop chat. Nearly the same skills as the Muse edition, with reference files included.",
  },
];

const aboutPoints = [
  {
    title: "What a skill is",
    desc: "A skill is a written procedure the AI remembers: “do this task this way”. Name it once and you get the same quality of work without rewriting the prompt.",
  },
  {
    title: "Born from real work",
    desc: "Each skill packages a task I kept repeating in client work: tidying layers, creating variables, building mockups, reviewing code.",
  },
  {
    title: "Tuned per environment",
    desc: "Claude Code, Figma’s Design Agent, Muse and Claude Desktop each get an edition adjusted to run there.",
  },
];

const recent = changelogSorted.slice(0, 5);
---

<Layout
  title="KMRVID Skills — Original skills for Claude Code, Figma, Muse and Claude Desktop"
  description={`${totalSkills + museSkillsCount + desktopSkillsCount} skills born from real web production work, in editions for Claude Code, Figma’s Design Agent, Muse and Claude Desktop.`}
  translated
>
  <Header />

  <main id="top">
    <section aria-labelledby="hero-heading" class="relative pt-14 md:pt-20 pb-0 overflow-hidden">
      <div class="items-center gap-10 grid grid-cols-1 md:grid-cols-[1.5fr_1fr] mx-auto px-6 max-w-5xl">
        <div>
          <p class="mb-4 text-ink-soft text-sm uppercase tracking-widest">
        KMRVID Skills
      </p>
      <h1 id="hero-heading" class="max-w-3xl text-ink max-sm:text-2xl text-balance text-left">
        Handing an AI a <span class="text-accent">skill</span> beats
        re-explaining the task every time
      </h1>
      <p class="mt-6 max-w-2xl text-ink-soft text-base text-justify leading-relaxed">
        Original skills born from real web production work, in editions for each environment. Start with the one that matches the tool you use.
      </p>
        </div>
        <div class="border border-border rounded-3xl overflow-hidden">
          <Image
            src={figmaWireframe}
            alt=""
            width={900}
            height={720}
            loading="eager"
            class="w-full h-full max-md:max-h-72 object-cover"
          />
        </div>
      </div>

      <div class="bg-ink mt-14 md:mt-20 text-canvas">
        <div class="gap-8 grid grid-cols-1 sm:grid-cols-3 mx-auto px-6 py-12 md:py-16 max-w-5xl text-left">
          <div>
            <p class="font-heading text-6xl md:text-7xl">4</p>
            <p class="mt-2 text-white/60 text-sm">Environments: Claude Code, Figma, Muse, Claude Desktop</p>
          </div>
          <div>
            <p class="font-heading text-6xl md:text-7xl">5</p>
            <p class="mt-2 text-white/60 text-sm">Products: single editions, plus the Claude + Figma Bundle</p>
          </div>
          <div>
            <p class="font-heading text-6xl md:text-7xl">{totalSkills}</p>
            <p class="mt-2 text-white/60 text-sm">Skills in the Bundle</p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="products"
      aria-labelledby="products-heading"
      class="mx-auto px-6 py-16 md:py-20 max-w-5xl"
    >
      <h2 id="products-heading" class="max-w-xl text-ink text-left">
        Pick by environment
      </h2>
      <ul class="gap-6 grid grid-cols-1 md:grid-cols-2 mt-10">
        {
          productCards.map((card) => {
            const product = products[card.key];
            return (
              <li
                class:list={[
                  "flex flex-col bg-canvas p-6 border border-border rounded-2xl",
                  card.key === "bundle" && "md:col-span-2",
                ]}
              >
                <p class="text-ink-soft text-sm uppercase tracking-wide">
                  {product.env}
                </p>
                <h3 class="mt-1 text-xl text-left leading-snug">
                  {product.en.name}
                </h3>
                <p class="mt-1 text-accent-dark text-sm">{card.title}</p>
                <p class="flex-1 mt-3 text-ink-soft text-base text-justify leading-snug">
                  {card.desc}
                </p>
                <p class="mt-4 text-ink-soft text-sm">
                  {product.skills} skills ·{" "}
                  <span class="font-heading text-ink text-xl">
                    {formatUsd(product.en.priceUsd)}
                  </span>
                  <span class="ml-1">one-time purchase</span>
                </p>
                <a
                  href={product.en.href}
                  class="inline-flex items-center gap-1.5 mt-4 min-h-11 text-ink hover:text-accent text-sm underline underline-offset-4 transition"
                >
                  See details
                  <ArrowRight size={14} stroke-width={2} />
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section aria-label="Concept" class="relative py-20 md:py-28 overflow-hidden text-canvas">
      <Image
        src={laptopWork}
        alt=""
        width={1920}
        height={1080}
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-ink/80"></div>
      <div class="z-10 relative mx-auto px-6 max-w-5xl">
        <p class="max-w-2xl font-heading text-2xl md:text-3xl text-balance text-left leading-snug">
          Skills born in real production work,<br class="sm:hidden" /> tuned for each environment.
        </p>
        <p class="mt-4 max-w-xl text-white/70 text-base text-balance text-left leading-relaxed">
          The same task, with the same quality, in Claude Code, Figma, Muse or Claude Desktop.
        </p>
      </div>
    </section>

    <section
      id="skills"
      aria-labelledby="skills-heading"
      class="py-20 md:py-28"
    >
      <div class="mx-auto px-6 max-w-5xl">
        <h2 id="skills-heading" class="max-w-xl text-ink text-left">
          About the skills
        </h2>
        <div
          class="*:flex *:flex-col gap-6 grid grid-cols-1 md:grid-cols-3 mt-10 *:bg-canvas *:p-6 *:border *:border-border *:rounded-2xl"
        >
          {
            aboutPoints.map((point) => (
              <div>
                <h3 class="text-lg text-left leading-snug">{point.title}</h3>
                <p class="mt-2 text-ink-soft text-base text-justify leading-snug">
                  {point.desc}
                </p>
              </div>
            ))
          }
        </div>
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-8">
          <li>
            <a
              href="/en/skills/"
              class="inline-flex items-center gap-1 min-h-11 text-ink hover:text-accent text-sm underline underline-offset-4 transition"
            >
              All Claude and Figma skills ({totalSkills})
              <ArrowRight size={14} stroke-width={2} />
            </a>
          </li>
          <li>
            <a
              href="/en/muse/#skills"
              class="inline-flex items-center gap-1 min-h-11 text-ink hover:text-accent text-sm underline underline-offset-4 transition"
            >
              Muse edition skills ({museSkillsCount})
              <ArrowRight size={14} stroke-width={2} />
            </a>
          </li>
          <li>
            <a
              href="/en/desktop/#skills"
              class="inline-flex items-center gap-1 min-h-11 text-ink hover:text-accent text-sm underline underline-offset-4 transition"
            >
              Desktop edition skills ({desktopSkillsCount})
              <ArrowRight size={14} stroke-width={2} />
            </a>
          </li>
        </ul>
      </div>
    </section>

    <CreatorBio />

    <section
      id="changelog"
      aria-labelledby="changelog-heading"
      class="mx-auto px-6 py-20 md:py-28 max-w-3xl"
    >
      <h2 id="changelog-heading" class="text-ink text-left">Changelog</h2>
      <ChangelogList entries={recent} lang="en" />
      <a
        href="/en/changelog/"
        class="inline-flex items-center gap-1.5 mt-6 min-h-11 text-ink hover:text-accent text-sm underline underline-offset-4 transition"
      >
        See the full changelog
        <ArrowRight size={14} stroke-width={2} />
      </a>
    </section>
  </main>

  <Footer />
</Layout>
