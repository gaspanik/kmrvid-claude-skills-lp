---
import {
  formatUsd,
  formatYen,
  type ProductKey,
  products,
} from "@/data/products";
import type { Lang } from "@/i18n/ui";

interface Props {
  product: ProductKey;
  /** en のとき海外版（USD）の価格を表示する */
  lang?: Lang;
}

const { product, lang = "ja" } = Astro.props;
const { price, campaign, en } = products[product];
---

{
  lang === "en" ? (
    formatUsd(en.priceUsd)
  ) : campaign ? (
    <>
      <span class="campaign-ended:hidden">{formatYen(campaign.price)}</span>
      <span class="hidden campaign-ended:inline">{formatYen(price)}</span>
    </>
  ) : (
    formatYen(price)
  )
}
