---
import { ArrowLeft, ArrowRight, Tag } from "@lucide/astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Callout from "@/components/Callout.astro";
import ImageLightbox from "@/components/ImageLightbox.astro";
import CategorySkills from "@/components/CategorySkills.astro";
import CounterpartTable from "@/components/CounterpartTable.astro";
import Layout from "@/layouts/Layout.astro";
import skillsDiagram from "@/assets/images/KMRVID_Skill_Map.webp";
import {
  claudeCategories,
  claudeSkills,
  claudeSkillsCount,
  figmaCategories,
  figmaSkills,
  figmaSkillsCount,
  totalSkills,
} from "@/data/skills";
import Price from "@/components/Price.astro";
import { AGENSI_URL, formatYen, products } from "@/data/products";

const PURCHASE_URL = products.bundle.url;
const PRICE = formatYen(products.bundle.price);
const LINE_URL = "https://lin.ee/EOgmkKQ";
---

<Layout
  title="収録スキル一覧 — KMRVID Skills - All-in-One Bundle"
  translated
>
  <Header />

  <main>
    <section class="mx-auto px-6 pt-14 md:pt-20 max-w-5xl">
      <a
        href="/#skills"
        class="inline-flex items-center gap-1.5 min-h-11 text-ink-soft hover:text-accent text-sm transition"
      >
        <ArrowLeft size={16} stroke-width={2} />
        トップページに戻る
      </a>

      <p class="mt-8 text-ink-soft text-sm uppercase tracking-widest">
        収録スキル一覧
      </p>
      <h1 class="max-w-2xl text-ink max-sm:text-2xl text-left">
        全{totalSkills}スキル。<br
          class="sm:hidden"
        />実務のワークフローをまるごと自動化する
      </h1>
      <p
        class="mt-4 max-w-2xl text-ink-soft text-base text-justify leading-relaxed"
      >
        セットアップからモックアップ作成、Figma連携、Tailwindの整理、仕上げの品質チェックまで、Web制作の一連の工程をカテゴリごとに整理しました。使い方だけでなく作り方の解説も付いているため、自分の業務に合わせたカスタマイズや新規スキル開発の参考にもなります。
      </p>
      <p
        class="mt-4 max-w-2xl text-ink-soft text-base text-justify leading-relaxed"
      >
        全{totalSkills}スキルの内訳は、Claude Code向けの
        <a href="/claude" class="text-accent underline underline-offset-4">
          KMRVID Claude Skills
        </a>
        （{claudeSkillsCount}スキル）と、Figma Design Agent向けの
        <a href="/figma" class="text-accent underline underline-offset-4">
          KMRVID Figma Skills
        </a>
        （{figmaSkillsCount}スキル）です。それぞれ単体パッケージとしても購入できます。
      </p>
      <p
        class="mt-4 max-w-2xl text-ink-soft text-base text-justify leading-relaxed"
      >
        2026年7月31日、公開中の Claude Code 用スキルの中から Figma Design Agent
        でも動作するスキルを移植。Figma
        に最適化された専用スキルを追加しました（{figmaSkillsCount}スキル／2026年9月20日現在）。Figma内での作業効率を大幅に向上させるカスタムスキルです。
      </p>

      <ImageLightbox
        image={skillsDiagram}
        thumbAlt="収録スキル同士の関係性を示した全体相関図"
        expandedAlt="収録スキル同士の関係性を示した全体相関図（拡大）"
        caption="スキル同士の組み合わせ・依存関係を俯瞰した全体相関図。クリックで拡大表示。"
      />
    </section>

    <!-- ============ PACKAGE NAV ============ -->
    <nav
      aria-label="パッケージ別ナビゲーション"
      class="mx-auto mt-10 px-6 max-w-5xl"
    >
      <ul class="flex flex-wrap gap-3 text-sm">
        <li>
          <a
            href="#claude"
            class="inline-flex items-center px-4 border border-border hover:border-accent rounded-full min-h-11 transition"
          >
            Claude Code版（{claudeSkillsCount}）
          </a>
        </li>
        <li>
          <a
            href="#figma"
            class="inline-flex items-center px-4 border border-border hover:border-accent rounded-full min-h-11 transition"
          >
            Figma Design Agent版（{figmaSkillsCount}）
          </a>
        </li>
        <li>
          <a
            href="#counterparts"
            class="inline-flex items-center px-4 border border-border hover:border-accent rounded-full min-h-11 transition"
          >
            Claude版とFigma版の対応表
          </a>
        </li>
        <li>
          <a
            href="/changelog/"
            class="inline-flex items-center px-4 border border-border hover:border-accent rounded-full min-h-11 transition"
          >
            更新履歴
          </a>
        </li>
      </ul>
    </nav>

    <!-- ============ CLAUDE ============ -->
    <section
      id="claude"
      aria-labelledby="claude-heading"
      class="mx-auto px-6 py-14 md:py-20 max-w-5xl scroll-mt-20"
    >
      <p class="text-ink-soft text-sm uppercase tracking-widest">
        Claude Code 向け
      </p>
      <h2 id="claude-heading" class="mt-2 text-ink text-left">
        KMRVID Claude Skills（{claudeSkillsCount}スキル）
      </h2>
      <p
        class="mt-3 max-w-2xl text-ink-soft text-base text-justify leading-relaxed"
      >
        Claude Code で動くスキルの単体パッケージです。セットアップからモックアップ作成、Figma連携、Tailwindの整理、仕上げの品質チェックまで、コードを書く側の工程を一通りカバーします。
      </p>
      <a
        href="/claude/"
        class="inline-flex items-center gap-1 mt-3 min-h-11 text-ink-soft hover:text-accent text-sm underline underline-offset-4 transition"
      >
        KMRVID Claude Skills の詳細を見る
        <ArrowRight size={14} stroke-width={2} />
      </a>

      <div class="mt-10">
        {
          claudeCategories.map((category) => (
            <CategorySkills
              category={category}
              lang="ja"
              known={claudeSkills.map((skill) => skill.name)}
            />
          ))
        }
      </div>
    </section>

    <!-- ============ FIGMA ============ -->
    <section
      id="figma"
      aria-labelledby="figma-heading"
      class="bg-surface-alt py-14 md:py-20 scroll-mt-20"
    >
      <div class="mx-auto px-6 max-w-5xl">
        <p class="text-ink-soft text-sm uppercase tracking-widest">
          Figma Design Agent 向け
        </p>
        <h2 id="figma-heading" class="mt-2 text-ink text-left">
          KMRVID Figma Skills（{figmaSkillsCount}スキル）
        </h2>
        <p
          class="mt-3 max-w-2xl text-ink-soft text-base text-justify leading-relaxed"
        >
          Figma の Design Agent（カスタムスキル登録機能）の中で動くスキルの単体パッケージです。キャンバス上で選択して呼び出すだけで使え、確認・質問・レポートはすべて日本語で表示されます。
        </p>
        <a
          href="/figma/"
          class="inline-flex items-center gap-1 mt-3 min-h-11 text-ink-soft hover:text-accent text-sm underline underline-offset-4 transition"
        >
          KMRVID Figma Skills の詳細を見る
          <ArrowRight size={14} stroke-width={2} />
        </a>

        <div class="mt-10">
          {
            figmaCategories.map((category) => (
              <CategorySkills
                category={category}
                lang="ja"
                known={figmaSkills.map((skill) => skill.name)}
                otherPackage="KMRVID Claude Skills"
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ COUNTERPARTS ============ -->
    <section
      id="counterparts"
      aria-labelledby="counterparts-heading"
      class="mx-auto px-6 py-14 md:py-20 max-w-5xl scroll-mt-20"
    >
      <h2 id="counterparts-heading" class="text-ink text-left">
        Claude版とFigma版の対応表
      </h2>
      <p
        class="mt-3 max-w-2xl text-ink-soft text-base text-justify leading-relaxed"
      >
        同名、または役割が対応するスキルの一覧です。基本の違いは入力方式で、Claude版はFigma URLを渡してFigma MCP経由で動作し、Figma版はキャンバス上で選択したノードに対してPlugin APIで直接動作します。Claude版にしかない・Figma版にしかないスキルは、この表には載せていません。
      </p>
      <CounterpartTable lang="ja" anchors />
    </section>

    <!-- ============ TRIAL NOTE ============ -->
    <section class="flex flex-col gap-4 mx-auto px-6 pb-14 md:pb-20 max-w-5xl">
      <Callout>
        Claude Code版の一部のスキルは、スキル販売サービス「Agensi」で単体購入もできます（無料のものもあり、有料のスキルは3回まで無料で試せます。Figma版はありません）。
        <a
          href={AGENSI_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4"
        >
          Agensiのクリエイターページ
        </a>
      </Callout>
      <Callout>
        購入前に動作を試したい方向けに、軽量版スキル「create-mockup-lite」を
        <a
          href="https://github.com/gaspanik/create-mockup-lite-skill"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4"
        >
          GitHub
        </a>
        にて無料公開しています。
      </Callout>
      <Callout>
        「create-mockup-lite」「click-to-fix」の紹介と作業環境についてこちらの
        <a
          href="https://youtu.be/TySJxHhMKNQ"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4"
        >
          YouTube
        </a>
        で動画を用意しています。
      </Callout>
    </section>

    <!-- ============ CTA ============ -->
    <section class="bg-ink py-20 md:py-28 text-canvas">
      <div
        class="flex flex-col items-center gap-6 mx-auto px-6 max-w-2xl text-center"
      >
        <Tag size={28} stroke-width={1.75} class="text-accent" />
        <h2 class="text-canvas">
          全{totalSkills}スキルを、<br class="sm:hidden" />{PRICE}円で
        </h2>
        <p
          class="max-w-md text-white/70 text-base sm:text-center text-justify leading-relaxed"
        >
          「KMRVID Skills - All-in-One Bundle」は、{PRICE}円（税込）の買い切りでお申し込みいただけます。
        </p>
        <a
          href={PURCHASE_URL}
          class="inline-flex items-center gap-2 bg-accent shadow-xs hover:brightness-110 px-8 py-4 rounded-full font-medium text-white transition"
        >
          {PRICE}円で申し込む
          <ArrowRight size={18} stroke-width={2} />
        </a>
        <p class="text-white/70 text-sm text-center leading-relaxed">
          公式LINE友だち登録で、さらに10%OFFクーポンも配布中<br />
          <a
            href={LINE_URL}
            class="inline-flex items-center min-h-11 text-white underline underline-offset-4"
          >
            LINEで10%OFFクーポンを受け取る
          </a>
        </p>
        <p class="text-white/60 text-sm">
          単体パッケージ：
          <a
            href="/claude"
            class="inline-flex items-center min-h-11 hover:text-white underline underline-offset-4"
          >
            Claude Skills（<Price product="claude" />円）
          </a>
          ／
          <a
            href="/figma"
            class="inline-flex items-center min-h-11 hover:text-white underline underline-offset-4"
          >
            Figma Skills（{formatYen(products.figma.price)}円）
          </a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
