---
import {
  ArrowRight,
  ArrowUpRight,
  CircleCheck,
  Combine,
  ExternalLink,
  FileText,
  Languages,
  ListChecks,
  MousePointerClick,
  Plus,
  SquareTerminal,
  Tag,
  Workflow,
} from "@lucide/astro";
import figmaWireframe from "@/assets/images/figma-wireframe.jpg";
import codeScreen from "@/assets/images/code-screen.jpg";
import Callout from "@/components/Callout.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FooterFigma from "@/components/FooterFigma.astro";
import HeaderFigma from "@/components/HeaderFigma.astro";
import SkillCard from "@/components/SkillCard.astro";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import { figmaSkills, totalSkills as claudeSkillsTotal } from "@/data/skills";

const PURCHASE_URL = "https://kmrvid.com/products/kmrvid-figma-skills";

const differences = [
  {
    icon: MousePointerClick,
    title: "キャンバス上で選択したノードが対象",
    description:
      "Figma URL の貼り付けは不要。フレームやセクションを選択してチャットで呼び出すだけで動きます。",
  },
  {
    icon: SquareTerminal,
    title: "Plugin API 直接実行で完結",
    description:
      "Figma 側のスクリプト実行ツールだけで完結し、外部のMCPツールを参照しません。",
  },
  {
    icon: FileText,
    title: "カスタムスキル登録は1ファイルで完結",
    description:
      "SKILL.md 単体を登録すれば動作します。Figma のカスタムスキル登録機能にそのまま貼り付け可能。",
  },
  {
    icon: Languages,
    title: "質問も出力もすべて日本語",
    description:
      "スキルの指示本文は英語ですが、確認テーブル・質問・レポートはすべて日本語で表示されます。",
  },
];

const skills = figmaSkills;

const steps = [
  {
    n: "01",
    title: "SKILL.mdを登録",
    desc: "Figma のカスタムスキル登録機能で、使いたいスキルの SKILL.md を登録します。",
  },
  {
    n: "02",
    title: "対象を選択",
    desc: "キャンバス上で対象のフレームまたはセクションを選択します（スキルによって対象が異なります）。",
  },
  {
    n: "03",
    title: "チャットから実行",
    desc: "チャットからスキル名を呼び出すだけで実行されます。確認・質問・レポートはすべて日本語で表示されます。",
  },
];

const combos = [
  {
    goal: "新しいページを一から作りたい",
    chain: ["brief-me", "create-multi-pattern"],
    desc: "要件をヒアリングしてBRIEFを作成後、それを引き継いで複数レイアウト案を一括生成。1案でよければ`create-single-page`（無質問・一発生成）に差し替え可能です。",
  },
  {
    goal: "色や数値を変数化、コンポーネント化まで進めたい",
    chain: ["figma-tokenize", "figma-componentize"],
    desc: "ハードコードされた色をまず変数化し、繰り返しパターンをコンポーネント化候補として提案。この2段階を一括で行いたい場合は`figma-systematize`が便利です。",
  },
  {
    goal: "ページ全体を整理して仕上げまで持っていきたい",
    chain: ["figma-systematize", "figma-enhance"],
    desc: "レイヤー名整理・トークン化・コンポーネント化を3段パイプラインで一括処理したうえで、さらなる改善点をページ全体から検出・提案・実装します。",
  },
  {
    goal: "要件に沿ってコピーを書き直したい",
    chain: ["brief-me", "rewrite-me"],
    desc: "ヒアリングしたBRIEFをそのまま引き継いで、選択したフレーム内のテキストを要件に合わせて書き直します。レイアウトや構造は変更しません。",
  },
  {
    goal: "実装前にAIが読み取りやすい構造か確認したい",
    chain: ["figma-systematize", "figma-audit"],
    desc: "レイヤー名整理・トークン化・コンポーネント化を`figma-systematize`で一括処理してから、実装精度を4観点で採点。コンポーネント単体を見たい場合は`figma-component-audit`に差し替えます。",
  },
  {
    goal: "色のアクセシビリティを確認・修正したい",
    chain: ["figma-contrast-check"],
    desc: "選択フレーム内テキストのWCAGコントラスト比をAA/AAAで判定し、コンパクトなレポートを出力。そのまま自動修正まで依頼することもできます。",
  },
  {
    goal: "フレーム内の日本語の処理を改善したい",
    chain: ["create-single-page", "figma-japanese-web-guideline"],
    desc: "禁則処理・斜体回避・見出しの整列など日本語特有の実装ガイドラインは、`figma-japanese-web-guideline`が担当。単独での利用も可能だが他のスキルと併用（一部は選択適用）することで、フレーム内の日本語の処理を自動で最適化できます。",
  },
  {
    goal: "人間の特性を考慮したページデザインにしたい",
    chain: ["create-multi-pattern"],
    claudeSkill: "cognitive-ui-design",
    desc: "視線誘導パターン（Z型・F型・バナーブラインドネス回避など）や認知バイアスを踏まえたレイアウト設計は、通常版限定の`cognitive-ui-design`が担当。Figma版の`create-multi-pattern`と併用すると、コンパニオンスキルとして裏で呼び出され、生成する複数パターンの質をさらに引き上げられます。",
  },
];

const totalSkills = skills.length;
---

<Layout title="KMRVID Figma Skills — Figma Design Agent専用カスタムスキル集">
  <HeaderFigma />

  <main id="top">
    <!-- ============ HERO ============ -->
    <section
      aria-labelledby="hero-heading"
      class="relative pt-14 md:pt-20 pb-0 overflow-hidden"
    >
      <div class="mx-auto px-6 max-w-5xl">
        <a
          href="/"
          class="inline-flex items-center gap-2 bg-ink mb-8 px-4 py-2 rounded-full font-medium text-white/90 text-sm"
        >
          <ArrowUpRight size={16} stroke-width={2} />
          Claude Code版のフルセットはこちら
        </a>

        <p class="mb-4 text-ink-soft text-sm uppercase tracking-widest">
          Figma Design Agent 専用カスタムスキル集
        </p>

        <h1
          id="hero-heading"
          class="max-w-3xl text-ink max-sm:text-3xl text-left"
        >
          面倒な
          <span class="text-accent">手作業</span>から、
          <br />
          あなたを解放する
        </h1>

        <p
          class="mt-6 max-w-2xl text-ink-soft text-base text-justify leading-relaxed"
        >
          Claude Code 版のスキルを Figma の Design Agent（カスタムスキル機能）で動作するよう最適化した専用パッケージです。チャットの往復は最小限。スキルを呼び出すだけで、新規のページ生成から複数のレイアウトパターンの生成、キャンバス上のレイヤー整理・トークン化・コンポーネント化まで、ほぼ全自動で完結できます。収録スキルの解説動画付き（20本／2026年8月18日現在）。
        </p>

        <div
          class="flex sm:flex-row flex-col items-start sm:items-center gap-4 mt-8"
        >
          <a
            href={PURCHASE_URL}
            class="inline-flex items-center gap-2 bg-accent shadow-xs hover:brightness-110 px-6 py-3.5 rounded-full font-medium text-white transition"
          >
            9,900円で受講をはじめる
            <ArrowRight size={18} stroke-width={2} />
          </a>
          <a
            href="#diff"
            class="inline-flex items-center gap-2 hover:bg-surface-alt px-6 py-3.5 border border-ink/15 rounded-full font-medium text-ink transition"
          >
            通常版との違い
          </a>
        </div>

        <div class="flex flex-col items-start">
          <a
            href="https://x.com/cipher/status/2087497917284385192"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 mt-6 min-h-11 text-ink-soft hover:text-accent text-sm underline underline-offset-4 transition"
          >
            Figma版スキルの使いどころ、便利なところ
            <ExternalLink size={14} stroke-width={2} />
          </a>

          <a
            href="https://youtube.com/live/Sy8Jn6qMsqY?feature=share"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 -mt-2 min-h-11 text-ink-soft hover:text-accent text-sm underline underline-offset-4 transition"
          >
            使い方をYouTubeでライブ配信しました（その1）
            <ExternalLink size={14} stroke-width={2} />
          </a>

          <a
            href="https://youtube.com/live/AH47JM3NYEI?feature=share"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 -mt-2 min-h-11 text-ink-soft hover:text-accent text-sm underline underline-offset-4 transition"
          >
            使い方をYouTubeでライブ配信しました（その2）
            <ExternalLink size={14} stroke-width={2} />
          </a>
        </div>
      </div>

      <!-- Bottom-up payload: numeral block + supporting image -->
      <div class="bg-ink mt-14 md:mt-20 text-canvas">
        <div
          class="items-center gap-10 grid grid-cols-1 md:grid-cols-[1fr_1.1fr] mx-auto px-6 py-12 md:py-16 max-w-5xl"
        >
          <div class="text-left">
            <div class="gap-8 grid grid-cols-2">
              <div>
                <p
                  class="flex items-baseline gap-2 font-heading text-6xl md:text-7xl"
                >
                  {totalSkills}
                  <span class="font-body text-white/50 text-lg">個</span>
                </p>
                <p class="mt-2 text-white/60 text-sm">収録スキル数</p>
              </div>
              <div>
                <p
                  class="flex items-baseline gap-2 font-heading text-6xl md:text-7xl"
                >
                  {totalSkills}
                  <span class="font-body text-white/50 text-lg">個</span>
                </p>
                <p class="mt-2 text-white/60 text-sm">Figma実機動作確認済み</p>
              </div>
            </div>
            <p class="mt-8 text-white/50 text-sm">
              2026/9/6 更新 — 新スキル「slot-table-maker」を追加
              <br />
              2026/9/3 更新 — 新スキル「figma-update-checker」「figma-update-patch」を追加
              <br />
              2026/8/28 更新 — 新スキル「figma-i18n-translator」を追加
              <br />
              2026/8/24 更新 — 新スキル「figma-mobile-convert」「figma-japanese-web-guidelines」を追加
              <br />
              2026/8/18 更新 — 解説動画を用途別にリニューアル。全20本に増量
            </p>
          </div>

          <figure
            class="border border-white/10 rounded-2xl aspect-video overflow-hidden"
          >
            <Image
              src={figmaWireframe}
              alt="MacBookの画面に表示されたワイヤーフレームデザイン"
              width={1200}
              height={800}
              class="w-full h-full object-cover"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ DIFFERENCES ============ -->
    <section
      id="diff"
      aria-labelledby="diff-heading"
      class="mx-auto px-6 py-20 md:py-28 max-w-5xl"
    >
      <h2 id="diff-heading" class="max-w-xl text-ink text-left">
        通常版と何が違うのか
      </h2>
      <p
        class="mt-4 max-w-xl text-ink-soft text-base text-justify leading-relaxed"
      >
        通常版「KMRVID Claude
        Skills」に含まれる同名スキルのFigma専用版。中身のロジックは同じでも、Figma上で問題なく動くように前提から作り直し最適化しています。通常版にはこちらの「KMRVID
        Figma Skills」が含まれます。
      </p>

      <div
        class="*:flex *:flex-col gap-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 *:bg-canvas mt-10 *:p-6 *:border *:border-border *:rounded-2xl"
      >
        {
          differences.map((item) => (
            <FeatureCard
              icon={item.icon}
              title={item.title}
              description={item.description}
            />
          ))
        }
      </div>

      <p class="mt-6 text-ink-soft text-sm text-justify leading-snug">
        ライセンスは全スキル共通でkmrvid.com講座参加者限定の利用規約です（各フォルダのLICENSEを参照）。
      </p>

      <div class="mt-6">
        <Callout>
          `cognitive-ui-design` は、通常版の「KMRVID Claude
          Skills」に含まれるスキルで、Figma専用版には含まれません。レイアウトの定石崩しなどのガイドラインは、その内容が重要であるため通常版のみでの提供です。
        </Callout>
      </div>
    </section>

    <!-- ============ SKILLS GRID ============ -->
    <section
      id="skills"
      aria-labelledby="skills-heading"
      class="bg-surface-alt py-20 md:py-28"
    >
      <div class="mx-auto px-6 max-w-5xl">
        <h2 id="skills-heading" class="max-w-xl text-ink text-left">
          収録{totalSkills}スキル
        </h2>
        <p
          class="mt-4 max-w-xl text-ink-soft text-base text-justify leading-relaxed"
        >
          Figmaのキャンバス上で選択して呼び出すだけで動く、{
            totalSkills
          }個のカスタムスキルです。
        </p>

        <div
          class="*:flex *:flex-col gap-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 *:bg-canvas mt-10 *:p-6 *:border *:border-border *:rounded-2xl"
        >
          {
            skills.map((skill) => (
              <SkillCard
                name={skill.name}
                desc={skill.desc}
                liteUrl={skill.liteUrl}
                liteLabel={skill.liteLabel}
              />
            ))
          }
        </div>

        <p class="mt-6 text-ink-soft text-sm">
          2026/8/28時点で、{
            totalSkills
          }スキルすべてFigma上での実機動作を確認済みです。Figma Design Agent
          は現在β版です。状況によっては正常に動作しない場合があります。
        </p>
      </div>
    </section>

    <!-- ============ HOW TO USE ============ -->
    <section
      id="how-to"
      aria-labelledby="how-to-heading"
      class="mx-auto px-6 py-20 md:py-28 max-w-5xl"
    >
      <div
        class="flex items-center gap-2 mb-4 text-ink-soft text-sm uppercase tracking-widest"
      >
        <Workflow size={18} stroke-width={2} />
        使い方
      </div>
      <h2 id="how-to-heading" class="max-w-xl text-ink text-left">
        3ステップで動かせる
      </h2>

      <ol class="gap-6 grid grid-cols-1 sm:grid-cols-3 mt-10">
        {
          steps.map((step) => (
            <li class="bg-canvas p-6 border border-border rounded-2xl">
              <p class="font-heading text-accent text-3xl">{step.n}</p>
              <h3 class="mt-3 text-lg text-left leading-snug">{step.title}</h3>
              <p class="mt-2 text-ink-soft text-base text-justify leading-snug">
                {step.desc}
              </p>
            </li>
          ))
        }
      </ol>

      <div class="flex flex-col gap-4 mt-10">
        <Callout>
          `brief-me` → `create-multi-pattern` または `rewrite-me`
          の順で実行すると、ヒアリングした BRIEF
          をそのまま貼り付けて要件として引き継げます。既存のページに対して文章の書き直しを行う場合は、BRIEF
          を渡して `rewrite-me` 単体でも動作します。
        </Callout>
        <Callout>
          `figma-componentize`はコンポーネント化候補の色が変数にバインドされていない場合、`figma-tokenize`を先に実行するか確認してきます。バリアント生成後にも色の変数化を提案するため、経由しなくても最終的には変数化された状態に持っていけます。
        </Callout>
      </div>
    </section>

    <!-- ============ COMBOS ============ -->
    <section
      id="combos"
      aria-labelledby="combos-heading"
      class="bg-surface-alt py-20 md:py-28"
    >
      <div class="mx-auto px-6 max-w-5xl">
        <div
          class="flex items-center gap-2 mb-4 text-ink-soft text-sm uppercase tracking-widest"
        >
          <Combine size={18} stroke-width={2} />
          Combination
        </div>
        <h2 id="combos-heading" class="max-w-xl text-ink text-left">
          こういう時は<br class="sm:hidden" />このスキルを使おう
        </h2>
        <p
          class="mt-4 max-w-xl text-ink-soft text-base text-justify leading-relaxed"
        >
          スキルは単体でも呼び出せますが、目的によっては複数のスキルを順番につなげることで、より効果的に問題を解決できます。代表的な組み合わせ例です。
        </p>
        <p class="flex items-center gap-2 mt-3 text-ink-soft text-sm">
          <span
            class="inline-block border border-accent/30 rounded-full w-3 h-3 bg-accent-soft"
          ></span>
          色付きのカードは、通常版「KMRVID Claude Skills」限定スキルとの組み合わせ例です
        </p>

        <div
          class="*:flex *:flex-col gap-6 grid grid-cols-1 sm:grid-cols-2 mt-10 *:p-6 *:border *:rounded-2xl"
        >
          {
            combos.map((combo) => (
              <div
                class={
                  combo.claudeSkill
                    ? "bg-accent-soft border-accent/30"
                    : "bg-canvas border-border"
                }
              >
                <h3 class="text-lg text-left leading-snug">{combo.goal}</h3>
                <div class="flex flex-wrap items-center gap-2 mt-3">
                  {combo.chain.map((skill, i) => (
                    <>
                      {i > 0 && (
                        <ArrowRight
                          size={14}
                          stroke-width={2}
                          class="text-ink-soft"
                        />
                      )}
                      <span class="bg-surface-alt px-2.5 py-1 rounded-full font-mono text-xs">
                        {skill}
                      </span>
                    </>
                  ))}
                  {combo.claudeSkill && (
                    <>
                      <Plus
                        size={14}
                        stroke-width={2}
                        class="text-accent-dark"
                      />
                      <span class="bg-accent px-2.5 py-1 rounded-full font-mono text-white text-xs">
                        {combo.claudeSkill}
                      </span>
                    </>
                  )}
                </div>
                <p class="flex-1 mt-3 text-ink-soft text-base text-justify leading-snug">
                  {combo.desc}
                </p>
                {combo.claudeSkill && (
                  <a
                    href="/"
                    class="inline-flex items-center self-start gap-1.5 mt-4 min-h-11 hover:text-accent text-sm underline underline-offset-4 transition text-accent-dark"
                  >
                    Claude版の詳細を見る
                    <ArrowUpRight size={14} stroke-width={2} />
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ PRICING ============ -->
    <section
      id="pricing"
      aria-labelledby="pricing-heading"
      class="bg-surface-alt py-20 md:py-28"
    >
      <div class="mx-auto px-6 max-w-5xl">
        <div class="max-w-xl">
          <p
            class="flex items-center gap-2 mb-4 text-sm uppercase tracking-widest text-accent-dark"
          >
            <Tag size={18} stroke-width={2} />
            料金
          </p>
          <h2 id="pricing-heading" class="text-ink text-left">
            KMRVID <br class="sm:hidden" /> Figma Skills
          </h2>
          <p class="mt-4 text-ink-soft text-base text-justify leading-relaxed">
            単体パッケージとして、{
              totalSkills
            }個のFigma専用スキルを、9,900円（税込）の買い切りでご利用いただけます。
          </p>
        </div>

        <div class="bg-ink mt-10 rounded-3xl overflow-hidden text-canvas">
          <div
            class="gap-10 grid grid-cols-1 md:grid-cols-[1.1fr_1fr] p-8 md:p-12"
          >
            <div>
              <p
                class="flex items-baseline gap-2 font-heading text-6xl md:text-7xl"
              >
                9,900<span class="text-2xl">円</span>
              </p>
              <p class="mt-2 text-white/60 text-sm">税込・買い切り</p>

              <a
                href={PURCHASE_URL}
                class="inline-flex items-center gap-2 bg-accent shadow-xs hover:brightness-110 mt-8 px-6 py-3.5 rounded-full font-medium text-white transition"
              >
                9,900円で申し込む
                <ArrowRight size={18} stroke-width={2} />
              </a>
            </div>

            <ul
              class="flex *:flex flex-col *:[&_svg]:flex-none *:items-start gap-3 *:gap-3 *:[&_svg]:mt-0.5 md:pl-8 md:border-white/10 md:border-l text-white/80 *:[&_svg]:text-accent text-base"
            >
              <li>
                <CircleCheck size={18} stroke-width={2} />
                <span>Figma専用カスタムスキル{totalSkills}個</span>
              </li>
              <li>
                <CircleCheck size={18} stroke-width={2} />
                <span>1ファイル完結・SKILL.md登録のみ</span>
              </li>
              <li>
                <CircleCheck size={18} stroke-width={2} />
                <span>確認・質問・レポートはすべて日本語</span>
              </li>
              <li>
                <CircleCheck size={18} stroke-width={2} />
                <span>買い切り・視聴期限なし</span>
              </li>
            </ul>
          </div>
        </div>

        <p
          class="mt-6 max-w-xl text-ink-soft text-sm text-justify leading-relaxed"
        >
          本パッケージに付属するオリジナルスキルは、Figma Design Agent
          は現在β版です。状況によっては正常に動作しない場合があります。個別のスキル修正・動作サポート対応は行っておりません。
        </p>
      </div>
    </section>

