---
import "@/styles/global.css";
import { campaignEndsAt } from "@/data/products";

interface Props {
  title?: string;
}

const { title = "Astro 7 + Tailwind CSS 4 Starter" } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {
      campaignEndsAt && (
        <script is:inline define:vars={{ campaignEndsAt }}>
          if (Date.now() >= new Date(campaignEndsAt).getTime())
            document.documentElement.setAttribute("data-campaign-ended", "");
        </script>
      )
    }
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/gen-interface-jp@0.8.0/cdn/all.css"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
